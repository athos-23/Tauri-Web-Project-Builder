{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri-Web-Project-Builder",
  "version": "1.0.0",
  "identifier": "com.webprojectbuilder.tauriwebprojectbuilder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri-Web-Project-Builder",
        "width": 1100,
        "height": 750,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "publisher": "athos23",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}